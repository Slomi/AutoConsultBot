# Токен от @BotFather
BOT_TOKEN=
# Telegram ID админов через запятую (узнать свой: /myid в боте)
ADMIN_IDS=
TIMEZONE=Europe/Moscow
DB_PATH=consultant.db
# Прокси, если api.telegram.org недоступен: socks5://user:pass@host:port
PROXY=

# LLM: gigachat | openai
LLM_PROVIDER=gigachat

# GigaChat: ключ авторизации из личного кабинета developers.sber.ru → GigaChat API → «Ключ авторизации»
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca.pem

# Любой OpenAI-совместимый API (если LLM_PROVIDER=openai)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=
